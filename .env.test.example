# Supabase Configuration for Testing
# Copy this file to .env.test and fill in your values
# IMPORTANT: Use a TEST/STAGING environment, NOT production!

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anonymous key (public key)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Your Supabase service role key (admin key - NEVER commit this!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Supabase URL without VITE_ prefix (for compatibility)
SUPABASE_URL=https://your-project.supabase.co

# Optional: Anon key without VITE_ prefix (for compatibility)
SUPABASE_ANON_KEY=your-anon-key-here
